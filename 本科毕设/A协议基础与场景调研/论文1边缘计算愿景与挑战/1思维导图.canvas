{
	"nodes":[
		{"id":"a112285f6777ca7c","type":"text","x":760,"y":0,"width":420,"height":80,"text":"**数据在边缘产生、计算却在云端**：500 ZB vs 云 10.4 ZB"},
		{"id":"91ae6ad89074be0d","type":"text","x":760,"y":104,"width":420,"height":80,"text":"云范式假设端设备只是消费者，IoT 时代既是生产者又是消费者"},
		{"id":"0efc53ca80274b81","type":"text","x":760,"y":208,"width":420,"height":56,"text":"三类应用云撑不住：超短响应 / 隐私 / 数据量太大"},
		{"id":"e4681916c5164cec","type":"text","x":760,"y":332,"width":420,"height":80,"text":"**提出 edge computing 范式**：计算放在数据源附近"},
		{"id":"fa4fec48a3adba96","type":"text","x":760,"y":436,"width":420,"height":80,"text":"edge = 数据源与云之间路径上的任意算力（手机/网关/cloudlet）"},
		{"id":"aa60d0e43ba44dbc","type":"text","x":760,"y":540,"width":420,"height":80,"text":"5 个案例落地：云卸载/视频分析/智能家居/智慧城市/协同边缘"},
		{"id":"6f1100bdb4f1de23","type":"text","x":760,"y":688,"width":420,"height":80,"text":"edgeOS 三层：通信 → 数据抽象 → 服务管理，Naming 纵贯全层"},
		{"id":"2c925487ead645ad","type":"text","x":760,"y":792,"width":420,"height":80,"text":"computing stream：计算跟着数据走的一条「加工流水线」"},
		{"id":"ac66c8d36b59ec23","type":"text","x":760,"y":896,"width":420,"height":80,"text":"六大挑战：可编程/命名/数据抽象/服务管理/隐私安全/优化指标"},
		{"id":"c2120674be4d0665","type":"text","x":760,"y":1044,"width":420,"height":56,"text":"人脸识别搬到边缘：900 → 169 ms"},
		{"id":"82ac8c3f4f546f68","type":"text","x":760,"y":1124,"width":420,"height":80,"text":"cloudlet 能耗降 30–40%，CloneCloud 降 20×"},
		{"id":"5abf776d5c77c0a6","type":"text","x":760,"y":1228,"width":420,"height":56,"text":"45% 的 IoT 数据将在边缘处理、不上云"},
		{"id":"12e8656a273ba3f4","type":"text","x":760,"y":1352,"width":420,"height":56,"text":"绪论动机段的四个论证数字（p.1–3）"},
		{"id":"01bac90749d9ae69","type":"text","x":760,"y":1432,"width":420,"height":56,"text":"总体架构章直接套 edgeOS 分层画法（p.4）"},
		{"id":"c082bb2e47bb80a4","type":"text","x":760,"y":1512,"width":420,"height":80,"text":"测试维度：latency / bandwidth / energy / cost（p.8–9）"},
		{"id":"2bb159fc5de8c7c7","type":"text","x":760,"y":1660,"width":420,"height":56,"text":"树莓派网关 = Edge 带的实体落点"},
		{"id":"d6fe57b4e1452ef3","type":"text","x":760,"y":1740,"width":420,"height":56,"text":"消息流水线：订阅 → 过滤聚合 → 必要数据上云"},
		{"id":"07224b3c5e115d1f","type":"text","x":760,"y":1820,"width":420,"height":56,"text":"遗嘱/断线重连 ↔ 可靠性三视角一一对应"},
		{"id":"dffa85c8bccbedfa","type":"text","x":20,"y":855,"width":310,"height":190,"text":"# 边缘计算愿景与挑战\nShi et al.\nIEEE IoT Journal 2016\n边缘计算的开山综述"},
		{"id":"6551280f2795af3a","type":"text","x":380,"y":90,"width":250,"height":84,"color":"1","text":"**问题**"},
		{"id":"30e118683ca77f9c","type":"text","x":380,"y":434,"width":250,"height":84,"color":"2","text":"**方法**"},
		{"id":"e7423ea7f786f3ec","type":"text","x":380,"y":790,"width":250,"height":84,"color":"5","text":"**关键机制**"},
		{"id":"efb0654323f77bb2","type":"text","x":380,"y":1122,"width":250,"height":84,"color":"3","text":"**关键数字**"},
		{"id":"c0846200aaa7ef78","type":"text","x":380,"y":1430,"width":250,"height":84,"color":"4","text":"**毕设价值**"},
		{"id":"61bbe08577cdb9ec","type":"text","x":380,"y":1726,"width":250,"height":84,"color":"6","text":"**落地动作**"},
		{"id":"9f12b5e0182bae82","type":"file","x":20,"y":1940,"width":310,"height":220,"file":"本科毕设/A协议基础与场景调研/论文1边缘计算愿景与挑战/1边缘计算愿景与挑战.md"}
