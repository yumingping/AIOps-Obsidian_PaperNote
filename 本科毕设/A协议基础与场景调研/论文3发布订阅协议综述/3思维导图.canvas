{
	"nodes":[
		{"id":"35acefb5091c52a1","type":"text","x":760,"y":0,"width":420,"height":80,"text":"IIoT 新增实时 + 高可靠要求，IoT 协议未必满足"},
		{"id":"cb2b0480b3475791","type":"text","x":760,"y":104,"width":420,"height":56,"text":"已有综述缺工业需求视角"},
		{"id":"e80d7d6c49a238ea","type":"text","x":760,"y":228,"width":420,"height":56,"text":"先立 5 条需求：互操作/安全/可扩展/实时/可靠"},
		{"id":"d065ab883b057c00","type":"text","x":760,"y":308,"width":420,"height":56,"text":"再给 8 个 pub/sub 协议逐条打分"},
		{"id":"3748f12c82c85bb2","type":"text","x":760,"y":432,"width":420,"height":80,"text":"**TCP 保可靠不实时；UDP 潜在实时但可靠性要自建**"},
		{"id":"3e948e73d64d74f7","type":"text","x":760,"y":536,"width":420,"height":56,"text":"OPC UA：唯一完全满足三层互操作（数据建模强）"},
		{"id":"dec1e2d0b50ed186","type":"text","x":760,"y":616,"width":420,"height":56,"text":"broker-based 架构天生带 SPOF"},
		{"id":"7b3c9a6c14bb00c5","type":"text","x":760,"y":740,"width":420,"height":80,"text":"15 篇综述中 MQTT 出现 14 次（关注度第一）"},
		{"id":"9ce4f166a945aa8c","type":"text","x":760,"y":844,"width":420,"height":56,"text":"HiveMQ 集群验证到百万级设备"},
		{"id":"603fa3b8da705a64","type":"text","x":760,"y":924,"width":420,"height":56,"text":"**没有任何协议全部满足 5 条需求**"},
		{"id":"c5830a5b5f829b21","type":"text","x":760,"y":1048,"width":420,"height":56,"text":"五需求矩阵 = 毕设选型评估框架"},
		{"id":"9ba0ffdfff98674d","type":"text","x":760,"y":1128,"width":420,"height":56,"text":"引 Table 2 论证选 MQTT 并声明实时边界"},
		{"id":"626e8a1a20c553dd","type":"text","x":760,"y":1208,"width":420,"height":56,"text":"「缺真实性能评估」支撑任务6 必要性"},
		{"id":"19d24dffea779848","type":"text","x":760,"y":1332,"width":420,"height":56,"text":"架构图按协议栈四层画（应用/传输/网络/接口）"},
		{"id":"6233f5c226dc39a1","type":"text","x":760,"y":1412,"width":420,"height":56,"text":"默认 TCP+TLS：接受时延换可靠，写明取舍"},
		{"id":"f4fb212127deab78","type":"text","x":760,"y":1492,"width":420,"height":80,"text":"架构图标注单点（MQTT-SN gateway 教训）"},
