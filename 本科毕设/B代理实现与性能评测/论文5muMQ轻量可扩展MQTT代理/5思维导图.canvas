{
 "nodes": [
  {
   "id": "0b494027d8932023",
   "type": "text",
   "x": 760,
   "y": 0,
   "width": 420,
   "height": 56,
   "text": "Mosquitto 单线程只用一核，堆硬件没用"
  },
  {
   "id": "e947e7cb762f780a",
   "type": "text",
   "x": 760,
   "y": 80,
   "width": 420,
   "height": 56,
   "text": "内核 TCP 栈系统调用开销 + 多核资源竞争"
  },
  {
   "id": "0320ed56abf1ed17",
   "type": "text",
   "x": 760,
   "y": 204,
   "width": 420,
   "height": 80,
   "text": "**每核一个 epoll 事件循环 + SO_REUSEPORT**"
  },
  {
   "id": "077761d048894ad9",
   "type": "text",
   "x": 760,
   "y": 308,
   "width": 420,
   "height": 80,
   "text": "mTCP 用户态 TCP 栈（kernel bypass，可选路径）"
  },
  {
   "id": "9a62fa12b8fd7797",
   "type": "text",
   "x": 760,
   "y": 456,
   "width": 420,
   "height": 56,
   "text": "预分配、fd 索引的 client 表"
  },
  {
   "id": "24d94953cb387efb",
   "type": "text",
   "x": 760,
   "y": 536,
   "width": 420,
   "height": 80,
   "text": "topic 树 + 根节点读写锁（SUB 写锁 / PUB 读锁）"
  },
  {
   "id": "7a0f405fe37c07a6",
   "type": "text",
   "x": 760,
   "y": 640,
   "width": 420,
   "height": 80,
   "text": "每核 1:1 的 App/TCP 线程对，跨核走消息队列"
  },
  {
   "id": "431df8212386038b",
   "type": "text",
   "x": 760,
   "y": 788,
   "width": 420,
   "height": 56,
   "text": "约 3K 行 C，移植 mTCP 只改 90 行"
  },
  {
   "id": "a4731d0200b3a5a0",
   "type": "text",
   "x": 760,
   "y": 868,
   "width": 420,
   "height": 80,
   "text": "50 对时 944K msg/s = 5.38 × Mosquitto"
  },
  {
   "id": "974b872840801b12",
   "type": "text",
   "x": 760,
   "y": 972,
   "width": 420,
   "height": 80,
   "text": "Mosquitto 上限约 128K 订阅者（时延 1743 ms）"
  },
  {
   "id": "80e42d6204621e2d",
   "type": "text",
   "x": 760,
   "y": 1076,
   "width": 420,
   "height": 56,
   "text": "mTCP 版 PMD 忙轮询恒占 1600% CPU"
  },
  {
   "id": "6eac71a92b9d5797",
   "type": "text",
   "x": 760,
   "y": 1200,
   "width": 420,
   "height": 56,
   "text": "单机 broker 多核化的标准答案"
  },
  {
   "id": "e8b4acadee805bbc",
   "type": "text",
   "x": 760,
   "y": 1280,
   "width": 420,
   "height": 56,
   "text": "多核可扩展是主因，mTCP 只是第二层增益"
  },
  {
   "id": "a60f5f7024829d10",
   "type": "text",
   "x": 760,
   "y": 1360,
   "width": 420,
   "height": 56,
   "text": "忙轮询不适合电池网关 → 论证选内核 epoll"
  },
  {
   "id": "086cdad8413066dc",
   "type": "text",
   "x": 760,
   "y": 1484,
   "width": 420,
   "height": 80,
   "text": "C++：epoll + SO_REUSEPORT + pthread 读写锁"
  },
  {
   "id": "3604536aff3b0d43",
   "type": "text",
   "x": 760,
   "y": 1588,
   "width": 420,
   "height": 56,
   "text": "树莓派 4 核绑核压测（taskset）验证线性扩展"
  },
  {
   "id": "5f9db4b8f9940239",
   "type": "text",
   "x": 760,
   "y": 1668,
   "width": 420,
   "height": 56,
   "text": "架构图画出跨核消息队列路径"
  },
  {
   "id": "3f5df241a090bd54",
   "type": "text",
   "x": 20,
   "y": 779,
   "width": 310,
   "height": 190,
   "text": "# muMQ轻量可扩展MQTT代理\nPipatsakulroj et al.\nIEEE 2017\n多核 broker 实现论文"
  },
  {
   "id": "680fdb03c736f726",
   "type": "text",
   "x": 380,
   "y": 26,
   "width": 250,
   "height": 84,
   "color": "1",
   "text": "**问题**"
  },
  {
   "id": "cdb150b392de8dc2",
   "type": "text",
   "x": 380,
   "y": 254,
   "width": 250,
   "height": 84,
   "color": "2",
   "text": "**方法**"
  },
  {
   "id": "6d3caca310f98dbe",
