{
 "nodes": [
  {
   "id": "519dbc332b7b1aa4",
   "type": "text",
   "x": 760,
   "y": 0,
   "width": 420,
   "height": 56,
   "text": "MQ 生态跨度太大，缺可比条件的横评"
  },
  {
   "id": "488a6377907ff10a",
   "type": "text",
   "x": 760,
   "y": 80,
   "width": 420,
   "height": 56,
   "text": "已有评测忽视 CPU/内存与资源约束"
  },
  {
   "id": "88f4d3e1b0c7b411",
   "type": "text",
   "x": 760,
   "y": 204,
   "width": 420,
   "height": 80,
   "text": "Rust 版 mq-bench 统一框架横评 8 个 broker"
  },
  {
   "id": "c99bdada4b3c4e30",
   "type": "text",
   "x": 760,
   "y": 308,
   "width": 420,
   "height": 80,
   "text": "1–4 vCPU 三档资源 × 并发 500→10000 对"
  },
  {
   "id": "cd0e17be558162df",
   "type": "text",
   "x": 760,
   "y": 456,
   "width": 420,
   "height": 56,
   "text": "消息头内嵌 64-bit 纳秒时间戳"
  },
  {
   "id": "8749e538b917ff7b",
   "type": "text",
   "x": 760,
   "y": 536,
   "width": 420,
   "height": 56,
   "text": "open-loop 令牌桶限速，暴露真实饱和点"
  },
  {
   "id": "03fb60f141cc319e",
   "type": "text",
   "x": 760,
   "y": 616,
   "width": 420,
   "height": 80,
   "text": "Toxiproxy 注入 TCP RST（MTTF 30s / MTTR 5s）"
  },
  {
   "id": "17a2d92456a59b7b",
   "type": "text",
   "x": 760,
   "y": 720,
   "width": 420,
   "height": 56,
   "text": "只报 p50/p95，吞吐只统计稳定期"
  },
  {
   "id": "6b0aa21e59e19355",
   "type": "text",
   "x": 760,
   "y": 844,
   "width": 420,
   "height": 80,
   "text": "多线程 native（NATS/Zenoh）90K msg/s"
  },
  {
   "id": "c46188c6e8ee67a1",
   "type": "text",
   "x": 760,
   "y": 948,
   "width": 420,
   "height": 56,
   "text": "单线程 Mosquitto 饱和 45K msg/s"
  },
  {
   "id": "bd4e7f5eb8f79bf8",
   "type": "text",
   "x": 760,
   "y": 1028,
   "width": 420,
   "height": 80,
   "text": "QoS0 丢 6.3–6.6% vs QoS1/2 全部 0%"
  },
  {
   "id": "e38e94e0b766bdfa",
   "type": "text",
   "x": 760,
   "y": 1132,
   "width": 420,
   "height": 56,
   "text": "JVM 系内存高 10–50 倍"
  },
  {
   "id": "16b8938cbe5c0762",
   "type": "text",
   "x": 760,
   "y": 1256,
   "width": 420,
   "height": 56,
   "text": "任务6 指标口径的权威模板"
  },
  {
   "id": "da9c0db2518b4a4b",
   "type": "text",
   "x": 760,
   "y": 1336,
   "width": 420,
   "height": 56,
   "text": "三档边缘硬件画像（网关/工控机/雾节点）"
  },
  {
   "id": "75c42aeb0bc07dda",
   "type": "text",
   "x": 760,
   "y": 1416,
   "width": 420,
   "height": 56,
   "text": "按负载 × 资源选 broker 的部署指南"
  },
  {
   "id": "6320240691c4b8b7",
   "type": "text",
   "x": 760,
   "y": 1540,
   "width": 420,
   "height": 56,
   "text": "树莓派 ≈ 1 vCPU/2GB 档做资源画像"
  },
  {
   "id": "b3cdabc525a90e45",
   "type": "text",
   "x": 760,
   "y": 1620,
   "width": 420,
   "height": 80,
   "text": "docker stats 采 CPU/内存（1s 采样）"
  },
  {
   "id": "df6541f486119f00",
   "type": "text",
   "x": 760,
   "y": 1724,
   "width": 420,
   "height": 80,
   "text": "C++：ACK 异步化，防 QoS2 串行阻塞（3.6×）"
  },
  {
   "id": "199362fe3fdfb4ca",
   "type": "text",
   "x": 20,
   "y": 819,
   "width": 310,
   "height": 190,
   "text": "# IoT边缘消息代理基准测试\nPaul et al.\narXiv 2026\nmq-bench：8 broker 横评"
  },
  {
   "id": "a5f6040052b12ce2",
   "type": "text",
   "x": 380,
   "y": 26,
   "width": 250,
   "height": 84,
   "color": "1",
   "text": "**问题**"
  },
  {
   "id": "f0c01006c88d8e3e",
   "type": "text",
   "x": 380,
   "y": 254,
   "width": 250,
   "height": 84,
   "color": "2",
   "text": "**方法**"
  },
  {
   "id": "0bb77974547261c1",
   "type": "text",
   "x": 380,
   "y": 574,
   "width": 250,
   "height": 84,
   "color": "5",
   "text": "**关键机制**"
  },
  {
   "id": "41699f345982eb04",
   "type": "text",
   "x": 380,
   "y": 974,
   "width": 250,
   "height": 84,
   "color": "3",
   "text": "**关键数字**"
  },
  {
   "id": "2c08189a7ac04067",
   "type": "text",
   "x": 380,
   "y": 1322,
   "width": 250,
   "height": 84,
   "color": "4",
   "text": "**毕设价值**"
  },
  {
   "id": "75b5e8bf6aabf69a",
