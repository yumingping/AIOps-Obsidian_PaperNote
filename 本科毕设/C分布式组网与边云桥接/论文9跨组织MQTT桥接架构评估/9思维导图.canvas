{
 "nodes": [
  {
   "id": "382396363556604b",
   "type": "text",
   "x": 760,
   "y": 0,
   "width": 420,
   "height": 80,
   "text": "跨组织有管理壁垒 + 信任边界，broker 侧桥接行不通"
  },
  {
   "id": "9ad54c8fc3ba674e",
   "type": "text",
   "x": 760,
   "y": 104,
   "width": 420,
   "height": 56,
   "text": "单 broker 架构在真实场景不适用"
  },
  {
   "id": "510a61b02d31a3cf",
   "type": "text",
   "x": 760,
   "y": 228,
   "width": 420,
   "height": 80,
   "text": "client 侧桥：订阅 → 转换 → 再发布，broker 零改动"
  },
  {
   "id": "811597bc3a5347d2",
   "type": "text",
   "x": 760,
   "y": 332,
   "width": 420,
   "height": 80,
   "text": "两种粒度对比：AUT1 每 provider 1 桥 vs AUT2 每流 1 桥"
  },
  {
   "id": "2d4dd99a6f88b16e",
   "type": "text",
   "x": 760,
   "y": 480,
   "width": 420,
   "height": 80,
   "text": "MQTT5：No Local 防回环 + Retain As Published"
  },
  {
   "id": "e8a25b8a52aa470a",
   "type": "text",
   "x": 760,
   "y": 584,
   "width": 420,
   "height": 56,
   "text": "通配符订阅按 provider 聚合 topic"
  },
  {
   "id": "46ae2aa9c72251d5",
   "type": "text",
   "x": 760,
   "y": 664,
   "width": 420,
   "height": 56,
   "text": "收发端同主机保证时钟同步"
  },
  {
   "id": "512c94e810d808f6",
   "type": "text",
   "x": 760,
   "y": 788,
   "width": 420,
   "height": 80,
   "text": "跨网+TLS 时延：QoS0/1/2 = 132/185/217 ms"
  },
  {
   "id": "d96c58a0a575fb46",
   "type": "text",
   "x": 760,
   "y": 892,
   "width": 420,
   "height": 80,
   "text": "QoS0 下 125KB 流每千条丢 997 条；1.5KB 只丢 1"
  },
  {
   "id": "deaef2008dada943",
   "type": "text",
   "x": 760,
   "y": 996,
   "width": 420,
   "height": 80,
   "text": "桥实例翻倍只慢 3–5 ms（传输成本 > 处理成本）"
  },
  {
   "id": "78508f9a7598ed3c",
   "type": "text",
   "x": 760,
   "y": 1100,
   "width": 420,
   "height": 80,
   "text": "topic 15B vs 29B 差 ≤ 1.4 ms"
  },
  {
   "id": "bd862030c2d89176",
   "type": "text",
   "x": 760,
   "y": 1248,
   "width": 420,
   "height": 56,
   "text": "边云桥接数据流的直接模板"
  },
  {
   "id": "a1357bc165e5fc9b",
   "type": "text",
   "x": 760,
   "y": 1328,
   "width": 420,
   "height": 56,
   "text": "「传输成本 > 处理成本」的选型论据"
  },
  {
   "id": "dbee1f7a04666919",
   "type": "text",
   "x": 760,
   "y": 1408,
   "width": 420,
   "height": 56,
   "text": "QoS 1 作默认档的实证依据"
  },
  {
   "id": "8b672fd4c2ff4d8f",
   "type": "text",
   "x": 760,
   "y": 1532,
   "width": 420,
   "height": 80,
   "text": "C++ bridge 进程：通配订阅 + 转换 + 再发布"
  },
  {
   "id": "561a4fa0f857b3f8",
   "type": "text",
   "x": 760,
   "y": 1636,
   "width": 420,
   "height": 56,
   "text": "启用 No Local / RAP 防回环"
  },
  {
   "id": "8dc5249508b421de",
   "type": "text",
   "x": 760,
   "y": 1716,
   "width": 420,
   "height": 56,
   "text": "10 轮重复 × 4000 条，消息带时间戳"
  },
  {
   "id": "f385c7b0be39ddac",
   "type": "text",
   "x": 20,
   "y": 803,
   "width": 310,
   "height": 190,
   "text": "# 跨组织MQTT桥接架构评估\nLima et al.\nICSA 2025\nclient 侧桥接 benchmark"
  },
  {
