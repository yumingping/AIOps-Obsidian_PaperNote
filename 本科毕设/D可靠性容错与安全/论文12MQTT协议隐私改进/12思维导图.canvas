{
 "nodes": [
  {
   "id": "63f9e0f10238e6d0",
   "type": "text",
   "x": 760,
   "y": 0,
   "width": 420,
   "height": 80,
   "text": "**topic 必须对 broker 明文 → 作息可被画像**"
  },
  {
   "id": "2c91f910a08a725c",
   "type": "text",
   "x": 760,
   "y": 104,
   "width": 420,
   "height": 56,
   "text": "TLS 只保传输层，不管元数据"
  },
  {
   "id": "c19b0866263213d3",
   "type": "text",
   "x": 760,
   "y": 228,
   "width": 420,
   "height": 56,
   "text": "5 种 topic 混淆，全部只在客户端做"
  },
  {
   "id": "cfbe5762141253ec",
   "type": "text",
   "x": 760,
   "y": 308,
   "width": 420,
   "height": 56,
   "text": "实现并验证 AOTP（进阶一次性口令）"
  },
  {
   "id": "3ba802139a815daa",
   "type": "text",
   "x": 760,
   "y": 432,
   "width": 420,
   "height": 56,
   "text": "PRF 同步随机 topic（DHKE 传种子）"
  },
  {
   "id": "d2218cb759543a71",
   "type": "text",
   "x": 760,
   "y": 512,
   "width": 420,
   "height": 56,
   "text": "hash 链一次性口令：每环只用一次"
  },
  {
   "id": "790045acc4ddf56a",
   "type": "text",
   "x": 760,
   "y": 592,
   "width": 420,
   "height": 56,
   "text": "AOTP = 隔项掺盐递推 + 随机多项式"
  },
  {
   "id": "31ccf9b13d9790e0",
   "type": "text",
   "x": 760,
   "y": 672,
   "width": 420,
   "height": 56,
   "text": "用 p/# 通配订阅过滤无关消息"
  },
  {
   "id": "41048f8176aed347",
   "type": "text",
   "x": 760,
   "y": 796,
   "width": 420,
   "height": 80,
   "text": "AOTP 解混淆 1–13 ms（RPi），占远程时延 10%"
  },
  {
   "id": "2f004fd55d534fcc",
   "type": "text",
   "x": 760,
   "y": 900,
   "width": 420,
   "height": 80,
   "text": "ESP8266 上约 120 ms（MCU 不做解混淆）"
  },
  {
   "id": "f8c2570e7356dfcb",
   "type": "text",
   "x": 760,
   "y": 1004,
   "width": 420,
   "height": 56,
   "text": "明文本地基线 3.7 ms"
  },
  {
   "id": "2c6b5b68ab74c2a9",
   "type": "text",
   "x": 760,
   "y": 1084,
   "width": 420,
   "height": 56,
   "text": "方案 A 的 payload 体积 +33%"
  },
  {
   "id": "a348afea78f2f306",
   "type": "text",
   "x": 760,
   "y": 1208,
   "width": 420,
   "height": 56,
   "text": "「安全与展望」章的扩展素材"
  },
  {
   "id": "3858a562f1ad3a11",
   "type": "text",
   "x": 760,
   "y": 1288,
   "width": 420,
   "height": 56,
   "text": "混淆 vs 明文 × 本地 vs 远程 2×2 实验"
  },
  {
   "id": "ada91c1b4cef4115",
   "type": "text",
   "x": 760,
   "y": 1368,
   "width": 420,
   "height": 56,
   "text": "混淆 ≠ 加密：统计侧信道仍是开放问题"
  },
  {
   "id": "5a68bb03d5458ae1",
   "type": "text",
   "x": 760,
   "y": 1492,
   "width": 420,
   "height": 56,
   "text": "网关做混淆/解混淆，MCU 只采集发布"
  },
  {
   "id": "6cff381ea38d244e",
   "type": "text",
   "x": 760,
   "y": 1572,
   "width": 420,
   "height": 56,
   "text": "映射表按发布频率排序降低试错开销"
  },
  {
   "id": "6078ed8c3ded2e11",
   "type": "text",
   "x": 760,
   "y": 1652,
   "width": 420,
   "height": 80,
   "text": "C++：OpenSSL HMAC/SHA-256 实现 hash 链"
  },
  {
   "id": "26182eaf6a10c27e",
   "type": "text",
   "x": 20,
   "y": 783,
   "width": 310,
   "height": 190,
   "text": "# MQTT协议隐私改进\nFischer et al.\nIEEE 2019\nAOTP topic 混淆"
  },
  {
   "id": "a9d570785d425443",
   "type": "text",
   "x": 380,
   "y": 38,
   "width": 250,
   "height": 84,
   "color": "1",
   "text": "**问题**"
  },
  {
   "id": "fec991c389475885",
   "type": "text",
   "x": 380,
   "y": 254,
   "width": 250,
   "height": 84,
   "color": "2",
   "text": "**方法**"
  },
  {
   "id": "268e20b8bde03f09",
